# Unbound Force — managed by uf init
# Dependencies (bun add created node_modules/ at repo root — task 3.1)
node_modules/
# Runtime data under .uf/ (databases, caches, locks, logs)
.uf/artifacts/
.uf/dewey/graph.db
.uf/dewey/graph.db-shm
.uf/dewey/graph.db-wal
.uf/dewey/*.lock
.uf/dewey/cache/
.uf/dewey/dewey.log
.uf/replicator/*.db
.uf/replicator/*.db-shm
.uf/replicator/*.db-wal
.uf/replicator/*.lock
# Workflow progress state (/uf.unleash, /uf.review-council — machine-local session tracking)
.uf/progress/
# Per-developer override file — never commit provider-specific model strings
.uf/review-matrix.override.yaml
# Devcontainer — OS-specific, generated by uf sandbox init
.devcontainer/
# Legacy tool directories (renamed to .uf/ in Spec 025)
.dewey/
.hive/
.unbound-force/
replicator.log
cells.json
node_modules
opencode.json
